// PKGPATH: gno.land/r/tbruyelle/gnoslinger/v0/filetests/z16_tutorial_filetest

package z16_tutorial_filetest

import (
	"testing"

	gnoslinger "gno.land/r/tbruyelle/gnoslinger/v0"
)

const (
	alice address = "g1alice00000000000000000000000000000000"
	bob   address = "g1bob0000000000000000000000000000000000"
)

// The tutorial's showdown (client/src/tutorial/, make gen-tutorial): the
// marshal (alice, the player) against the kid (bob, scripted). Each turn
// the kid commits first, the game view is printed as the tutorial shows it
// while planning, then the marshal reveals in clear and the kid's reveal
// resolves the turn. The salts are picked so that the cards play the
// lesson: turn 3 the kid misses and the marshal wounds it, turn 4 the
// marshal kills it. A change to the rules that changes this output means
// the tutorial's script needs looking at again.
func main(cur realm) {
	type turn struct{ mSalt, mPlan, kSalt, kPlan string }
	turns := []turn{
		{"a1", "1f:ahead,2f:ahead,3b:ahead_left", "b1", "1f:ahead,3b:ahead_left"}, // movement
		{"a2", "9f:1:0", "b2", "9f:1:0,5f:aim:@0"},                                // draw & cock
		{"a36b", "5f:aim:@1,7f:shoot:@1", "b3", "7f:shoot:@0,6f:cock"},            // aim & shoot
		{"a48", "6f:cock,5f:aim:@1,7f:shoot:@1", "b4", "5f:aim:@0,7f:shoot:@0"},   // delays, the kill
	}
	testing.SetRealm(testing.NewUserRealm(alice))
	id := gnoslinger.CreateGame(cross(cur), 2, 10, 0, "A-D6", 2)
	testing.SetRealm(testing.NewUserRealm(bob))
	gnoslinger.JoinGame(cross(cur), id, "A-H6", 5)
	for i, t := range turns {
		n := i + 1
		testing.SetRealm(testing.NewUserRealm(bob))
		gnoslinger.Commit(cross(cur), id, gnoslinger.PlanHash(id, n, 1, t.kSalt, t.kPlan), "locked")
		println(gnoslinger.GameJSON(id))
		testing.SetRealm(testing.NewUserRealm(alice))
		gnoslinger.Reveal(cross(cur), id, n, 0, t.mSalt, t.mPlan)
		testing.SetRealm(testing.NewUserRealm(bob))
		gnoslinger.Reveal(cross(cur), id, n, 1, t.kSalt, t.kPlan)
	}
	println(gnoslinger.GameJSON(id))
	println(gnoslinger.HistoryJSON(id))
}

